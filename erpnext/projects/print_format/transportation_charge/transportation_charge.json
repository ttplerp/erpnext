 "html": "<!DOCTYPE html>\r\n<head>\r\n\t<div >\r\n        <div class=\"letter-head\">\r\n            {{letter_head}}\r\n        </div>\r\n    </div>\r\n</head>\r\n\r\n<body>\r\n    <div class=\"body_one\">\r\n        <p style=\"font-weight:bold;font-size:16px;text-align:center\">\r\n          <strong> Employee Advance Settlement</strong>\r\n        </p>\r\n        <p style=\"font-size:14px;text-align:center;text-decoration:underline\">{{doc.name}}</p>\r\n    </div>\r\n    <div style=\"padding-left:10px; padding-right:10px;\">\r\n       \r\n        <hr>\r\n         \r\n    \r\n    </div>\r\n    <table id=\"div_tab\">\r\n            <tr>\r\n                <td><strong>WorkFlow State:</strong></td>\r\n                <td>{{doc.workflow_state}}</td>\r\n                <td><strong>Posting Date:</strong></td>\r\n                <td>{{doc.posting_date}}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><strong>Branch:</strong></td>\r\n                <td>{{doc.branch}}</td>\r\n                <td><strong>  Bill Date:</strong></td>\r\n                <td>{{doc.bill_date}}</td>\r\n            </tr>\r\n             <tr>\r\n                <td><strong>Cost Center:</strong></td>\r\n                <td>{{doc.cost_center}}</td>\r\n                <td><strong>Company:</strong></td>\r\n                <td>{{doc.company}}</td>\r\n            </tr>\r\n             <tr>\r\n                <td><strong>Currency:</strong></td>\r\n                <td>{{doc.currency}}</td>\r\n                <td><strong>Journal Entry:</strong></td>\r\n                <td>{{doc.journal_entry}}</td>\r\n            </tr>\r\n            <tr>\r\n                <td><strong>Bill No :</strong></td>\r\n                <td>{{doc.bill_no}}</td>\r\n                \r\n            </tr>\r\n           \r\n    </table>\r\n    <div style=\"padding:10px;\">\r\n        <table class =\"table1\">\r\n             {% set slno = 0 %}\r\n        <tr id=\"col\">\r\n            <th id=\"col\"><strong>Sr</strong></th>\r\n            <th id=\"col\"><strong>Party Type</strong></th>\r\n            <th id=\"col\"><strong>Party</strong></th>\r\n            <th id=\"col\"><strong>Branch</strong></th>\r\n            <th id=\"col\"><strong>Total Amount</strong></th>\r\n             <th id=\"col\"><strong>Cost Center</strong></th>\r\n            \r\n    \r\n        </tr>\r\n\r\n         \r\n            {%- for index, row in enumerate(doc.items, start = 1) -%}\r\n      <tr>\r\n          \r\n            <tr id=\"col\">\r\n              \r\n       \r\n                <td id=\"col\" style=\"text-align: left\">{{index}}</td>\r\n                <td id=\"col\" style=\"text-align: left\">{{row.party_type}}</td>\r\n                <td id=\"col\" style=\"text-align: left\">{{row.party}}</td>\r\n                <td id=\"col\" style=\"text-align: left\"> Nu. {{row.branch}}</td>\r\n                <td id=\"col\" style=\"text-align: left\">Nu. {{row.total_amount}}\r\n                  <td id=\"col\" style=\"text-align: left\">Nu. {{row.cost_center}}\r\n                </td>\r\n                \r\n              \r\n                  <!--<td id=\"col\" style=\"text-align: right\">Nu. {{row.credit}}</td>-->\r\n                  <!--  <td id=\"col\" style=\"text-align: right\">Nu. {{row.debit}}</td>-->\r\n              \r\n            </tr>\r\n           \r\n        {% endfor %}\r\n        </table>\r\n    </div>\r\n    \r\n    <table id=\"div_tab\">\r\n   \r\n            <tr>\r\n                <td><strong>Approver: </strong> <br> {{doc.approver}} </td>\r\n                <td><strong>Approver Name:</strong> <br>{{doc.approver_name}}</td>\r\n                  <td><strong>Approver Designation :</strong> <br> {{doc.approver_designation}}</td>\r\n               \r\n            </tr>\r\n            \r\n    </table>\r\n    <!--<p style=\"padding-top:10px; padding-left:10px\"><strong>Narration:</strong> {{doc.narration}}</p>-->\r\n    <div class=\"row section-break\" style=\"margin-top: 60px; padding-left:80px\">\r\n\r\n\t\t<div class=\"col-xs-6 column-break\" style=\"text-align: left;\"> Prepared by <br><p>{{frappe.db.get_value(\"User\", doc.owner, \"full_name\")}}</p></div>\r\n\t\t<div class=\"col-xs-6 column-break\" style=\"text-align: center;\">Approved by <p></p></div>\r\n\t</div>\r\n\t<div class=\"row section-break\" style=\"margin-top: 60px; padding-left:10px\">\r\n\t\t<div class=\"col-xs-6 column-break\" style=\"text-align: left;\"></div>\r\n\t\t{%\r\n\t\t    if doc.naming_series == \"Bank Payment Voucher\" or doc.naming_series == \"Cash Payment Voucher\"\r\n\t\t%}\r\n\t\t<div class=\"col-xs-6 column-break\" style=\"text-align: center;\">Received By</div>\r\n\t\t {% endif %}\r\n\t\t<br><br>\r\n\t\t<hr>\r\n\t</div>\r\n    <div class=\"footer\">\r\n        {% if not no_letterhead and footer %}\r\n        <div class=\"letter-head-footer\">\r\n          {{ footer }}\r\n        </div>\r\n        {% endif %}\r\n        <p class=\"text-center small page-number visible-pdf\">\r\n            {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\r\n        </p>\r\n    </div>\r\n</body>",
